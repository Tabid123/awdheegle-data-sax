{
  "name": "awdheegle-data-sax",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "awdheegledata.com",
      "custom_domain": true
    }
  ]
}
